  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Saeris/plex-monitor.git"
  },
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "start": "vp pack && node scripts/run-binary.ts",
    "plxm:install": "vp pack && node scripts/run-binary.ts install",
    "plxm:upgrade": "git pull --ff-only && vp install && vp run plxm:install",
    "lint": "vp lint"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "mri": "^1.2.0",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@saeris/eslint-config": "^3.2.4",
    "@tsdown/exe": "patch:@tsdown/exe@npm%3A0.22.0#~/.yarn/patches/@tsdown-exe-npm-0.22.0-7094487e5f.patch",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "catalog:",
    "msw": "^2.14.6",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=26.1.0"
  },
  "packageManager": "yarn@4.18.1"
